- * 8 bytes per point (id, x lo, x hi, y lo, y hi, w, pressure, area),
- * little-endian coordinates. Ack by writing one zero byte to 0x824E. */
-#define GT9889_VER_REG   0x8240u
-#define GT9889_EVENT_REG 0x824Eu
-#define GT9889_POINT_LEN 8u

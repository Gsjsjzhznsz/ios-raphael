 int
 sweet_rpmh_vreg_enable(const char *res, unsigned mv)
 {
-	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
+	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary
+	 * resources. RAPHAEL: exactly the three sm8150 USB HS PHY rails as
+	 * mainline raphael wires them (all HPM): vdda33 = ldoa2 3072 mV,
+	 * vdda-pll = ldoa5 880 mV, vdda18 = ldoa12 1800 mV. SWEET: PM6150L
+	 * L11C (ldoc11) 2950..3400 mV. */
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+	static const struct rh_rail {
+		const char *name;
+		unsigned lo, hi;
+	} rh_rails[] = {
+		{ "ldoa2", 3000, 3120 },
+		{ "ldoa5", 800, 900 },
+		{ "ldoa12", 1700, 1900 },
+	};
+	const struct rh_rail *rail = NULL;
+	if (res) {
+		for (unsigned i = 0; i < sizeof(rh_rails) / sizeof(rh_rails[0]); ++i) {
+			if (!strcmp(res, rh_rails[i].name)) {
+				rail = &rh_rails[i];
+				break;
+			}
+		}
+	}
+	if (!rail || mv < rail->lo || mv > rail->hi) {
+		printf("SWEET RPMH: %s@%u mV is not a supported raphael USB LDO request\n",
+		    res ? res : "(null)", mv);
+		return EINVAL;
+	}
+#else
 	if (!res || strcmp(res, "ldoc11") || mv < 2950 || mv > 3400) {
 		printf("SWEET RPMH: expected ldoc11 and 2950..3400 mV\n");
 		return EINVAL;
 	}
+#endif
 	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
 		return EBUSY;
 	}

 /*
  * SWEET PM6150L L11C bring-up; see report.md for DT and source evidence.
  * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
+ * RAPHAEL (0103): also votes the sm8150 USB HS PHY rails (ldoa2/ldoa5/
+ * ldoa12) for sweet_usb.c before the femto sequence - raphael apps_rsc
+ * geometry is identical (drv-id 2, ACTIVE 2/SLEEP 3/WAKE 3, same RSC/
+ * TCS/cmd-db-locator addresses), so the TCS discipline is reused as-is.
  * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
@@ -234,7 +238,7 @@ rh_send(uint32_t address, unsigned mv)
 		for (unsigned c = 0; c < rh_ncpt; ++c) {
 			if ((enabled & (1u << c)) &&
 			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
-				printf("SWEET RPMH: conflicting inherited L11C request in TCS%u\n", t);
+				printf("SWEET RPMH: conflicting inherited request in TCS%u\n", t);
 				return EBUSY;
 			}
 		}
@@ -320,18 +324,47 @@ rh_send(uint32_t address, unsigned mv)
 		return EIO;
 	}
 	rh_poisoned = false;
-	printf("SWEET RPMH: L11C ACTIVE vote complete (rail voltage requires hardware verification)\n");

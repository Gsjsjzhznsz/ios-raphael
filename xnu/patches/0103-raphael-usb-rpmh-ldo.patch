 #define GCC_PA                  0x00100000
@@ -938,6 +939,30 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	if (hsphy != 0 && gccb != 0) {
 		printf("SWEET USB: hsphy pre-state COMMON0 0x%08x CTRL2 0x%08x CTRL5 0x%08x CFG0 0x%08x\n",
 		    usb_rd(hsphy, 0x54), usb_rd(hsphy, 0x64), usb_rd(hsphy, 0x50), usb_rd(hsphy, 0x94));
+		/* 0103: Linux qcom_snps_hsphy_init() enables vdda-pll/vdda33/vdda18
+		 * FIRST (regulator_bulk_enable is its very first step) - the femto
+		 * register file needs its analog rails up before any write sticks.
+		 * t17 proof the rails are down at handoff: every readback returned
+		 * repeating-byte garbage (COMMON1 0x3b3b3b3b, REFCLK 0x02020202,
+		 * CTRL2 0x06666606) and no femto write stuck, so the ep0 command
+		 * still found no UTMI clock (boot A wedged a CPU at ep0; the 45 s
+		 * touch start escalated it into the warm reboot; boot B died even
+		 * earlier, inside the pre-state printf). Vote the three rails
+		 * through RPMh exactly as mainline raphael wires them (all HPM):
+		 * vdda33 = ldoa2 @ 3072 mV, vdda-pll = ldoa5 @ 880 mV, vdda18 =
+		 * ldoa12 @ 1800 mV. A failed vote aborts here: reading a dead PHY
+		 * returns garbage but survives, while the ep0 command WRITE wedges
+		 * the boot CPU and turns every failure into the 45 s reboot loop. */
+		int ldoerr = sweet_rpmh_vreg_enable("ldoa2", 3072);
+		ldoerr |= sweet_rpmh_vreg_enable("ldoa5", 880);
+		ldoerr |= sweet_rpmh_vreg_enable("ldoa12", 1800);
+		printf("SWEET USB: hsphy post-LDO COMMON0 0x%08x CTRL2 0x%08x CTRL5 0x%08x CFG0 0x%08x (ldo err %d)\n",
+		    usb_rd(hsphy, 0x54), usb_rd(hsphy, 0x64), usb_rd(hsphy, 0x50), usb_rd(hsphy, 0x94),
+		    ldoerr);
+		if (ldoerr) {
+			printf("SWEET USB: hsphy LDO vote failed; gadget start aborted before PHY reset (no ep0 wedge)\n");
+			return;
+		}
 		/* GCC_QUSB2PHY_PRIM_BCR 0x12000 (gcc-sm8150.c): assert >= 100 us,
 		 * then release - resets all PHY registers to default state. */
 		*(volatile uint32_t *)(gccb + 0x12000) = 1;

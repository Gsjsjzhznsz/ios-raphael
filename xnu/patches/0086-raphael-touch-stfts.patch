+/* ST FTS event FIFO, strictly read-only (see the protocol note above).
+ * Enter/motion update contacts; leave and unknown events just drop ids
+ * from the mask. If the IC is not sensing (fresh power-up without panel
+ * init) the FIFO stays silent and nothing is reported. */
+static int
+touch_stfts(void)
+{
+	uint8_t buf[STFTS_EVT_LEN * 32];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	const uint8_t cmd = STFTS_FIFO_CMD;
+	int err = touch_msg(STFTS_ADDR, &cmd, 1, buf, STFTS_EVT_LEN, true);
+	if (err) {
+		return err;
+	}
+	if (buf[0] == 0x00u) {
+		return 0; /* EVT_ID_NOEVENT: retain current contacts */
+	}
+	unsigned more = buf[7] & 0x1fu;
+	if (more > 31u) {
+		return EIO;
+	}
+	if (more) {
+		err = touch_msg(STFTS_ADDR, &cmd, 1, buf + STFTS_EVT_LEN,
+		    more * STFTS_EVT_LEN, true);
+		if (err) {
+			return err;
+		}
+	}
+	for (unsigned e = 0; e <= more; ++e) {
+		const uint8_t *evt = buf + e * STFTS_EVT_LEN;
+		unsigned id = (evt[1] & 0xf0u) >> 4;
+		unsigned type = evt[1] & 0x0fu;
+		if (evt[0] >> 4 == 0x1u || evt[0] >> 4 == 0x2u) {
+			/* enter/motion; skip invalid/stylus, accept the rest */
+			if (type == 0x00u || type == 0x03u || id >= TOUCH_MAX) {
+				continue;
+			}
+			int px = (int)(((evt[3] & 0x0fu) << 8) | evt[2]);
+			int py = (int)((evt[4] << 4) | ((evt[3] & 0xf0u) >> 4));
+			if (px > 1079 || py > (int)TOUCH_MAX_Y) {
+				return EIO;
+			}
+			mask |= 1u << id;
+			x[id] = px;
+			y[id] = py;
+		}
+		/* 0x3 leave (drop from mask), 0x4 status, 0x5 user, 0xe debug,
+		 * 0xf error: nothing to do; touch_report() drops the ids. */
+	}
+	touch_report(mask, x, y);
+	return 0;
+}

diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 3b245e2..db78e2b 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -125,7 +125,13 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 		return -1;
 	}
 	unsigned off = 0x80u * apid;
-	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	/* Observer command word per Linux pmic_arb_fmt_cmd_v2: opcode<<27 |
+	 * sid<<20 | addr<<4 | (len-1). The sid field was missing through t11:
+	 * harmless on SWEET (PM6150 = SID 0), but raphael reads PM8150B on
+	 * SID 2, so every battery read targeted SID 0 and the QG type check
+	 * failed silently -> static fallback. */
+	uint32_t cmd = (1u << 27) | ((uint32_t)(sid & 0xfu) << 20) |
+	    ((addr & 0xffu) << 4);
 	__asm__ volatile("dmb oshst" ::: "memory");
 	*(volatile uint32_t *)(sp_obs + off) = cmd; /* EXT_READL, BC=0 */
 	__asm__ volatile("dsb osh" ::: "memory");

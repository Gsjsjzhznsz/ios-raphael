+/* User clients must forward connect-set-properties to the service
+ * themselves (see Apple's IOHIDEventServiceUserClient): the base
+ * IOUserClient::setProperties does not. Without this the
+ * AppleCLCD brightness hook below can never be reached. */
+IOReturn
+IOMobileFramebufferUserClient::setProperties(OSObject *properties)
+{
+	if (fFB != NULL) {
+		return fFB->setProperties(properties);
+	}
+	return IOUserClient::setProperties(properties);
+}

+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+/* DCS 0x51, big-endian 11-bit level, the vendor _ss variant. */
+void
+AppleCLCD::setPanelBrightness(uint32_t level)
+{
+	if (level < SWEET_FB_BRIGHT_MIN) {
+		level = SWEET_FB_BRIGHT_MIN;
+	}
+	if (level > SWEET_FB_BRIGHT_MAX) {
+		level = SWEET_FB_BRIGHT_MAX;
+	}
+	if (!fDsiOk) {
+		return;
+	}
+	uint32_t dw[2];
+	dw[0] = 0x02u | (0x39u << 16) | (0xc0u << 24);
+	dw[1] = ((level >> 8) & 0xffu) | ((level & 0xffu) << 8) | 0xffff0000u;
+	if (fbDsiSend(fDsi, dw, 2)) {
+		fBrightness = level;
+		IOLog("SWEET FB: brightness %u\n", level);
+	} else {
+		fDsiOk = false;
+		IOLog("SWEET FB: brightness DCS failed; panel DCS disabled\n");
+	}
+}
+
+/* DCS set_display_on/off (0x29/0x28): short write, no parameter. */
+bool
+AppleCLCD::dsiDisplayOnOff(bool on)
+{
+	if (!fDsiOk) {
+		return false;
+	}
+	uint32_t dw = (on ? 0x29u : 0x28u) | (0x05u << 16) | (0x80u << 24);
+	return fbDsiSend(fDsi, &dw, 1);
+}
+
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict != NULL) {
+		OSNumber *n = OSDynamicCast(OSNumber,
+		    dict->getObject("brightness"));
+		if (n == NULL) {
+			n = OSDynamicCast(OSNumber,
+			    dict->getObject("ApplePanelBrightness"));
+		}
+		if (n != NULL) {
+			IOLog("SWEET FB: setProperties brightness %u\n",
+			    n->unsigned32BitValue());
+			setPanelBrightness(n->unsigned32BitValue());
+		}
+	}
+	return IOService::setProperties(properties);
+}
+#endif /* ARM64_BOARD_CONFIG_RAPHAEL */

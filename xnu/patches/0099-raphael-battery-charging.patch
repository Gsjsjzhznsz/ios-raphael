+/* APSD charger classification (smb5-reg.h, single-bit result). */
+static const char *
+fgApsdName(uint8_t result)
+{
+	switch (result & 0x7fu) {
+	case 0x40u:
+		return "QC3.0";
+	case 0x20u:
+		return "QC2.0";
+	case 0x10u:
+		return "FLOAT";
+	case 0x08u:
+		return "DCP";
+	case 0x04u:
+		return "CDP";
+	case 0x02u:
+		return "OCP";
+	case 0x01u:
+		return "SDP";
+	default:
+		return "none";
+	}
+}
+
+static const char *
+fgChgStateName(unsigned state)
+{
+	static const char *names[] = { "INHIBIT", "TRICKLE", "PRE", "FULLON",
+	    "TAPER", "TERMINATE", "PAUSE", "DISABLE" };
+	return state < 8 ? names[state] : "?";
+}

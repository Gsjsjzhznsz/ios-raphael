 bool
+SweetBattery::inputCheck(void)
+{
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+	/* Quick USBIN/CHGR sample compared against the values poll() cached.
+	 * Returns true when they moved so timerFired runs a full poll (whose
+	 * transition block then logs the complete input line, republishes to
+	 * powerd and takes over the caching). inputCheck deliberately does
+	 * NOT cache: it would swallow the transition log (t21 fix of the
+	 * historical 0097, whose transition dump could never fire). */
+	uint8_t usb = 0, chg = 0;
+	if (!fReal ||
+	    sweet_spmi_read(SWEETBATT_SID, SWEETBATT_USBIN_RT_STS, &usb) ||
+	    sweet_spmi_read(SWEETBATT_SID, SWEETBATT_CHGR_STATUS1, &chg)) {
+		return false;
+	}
+	int plugin = (usb & SWEETBATT_USBIN_PLUGIN_BIT) != 0;
+	int state = chg & 7;
+	return plugin != fLastPlugin || state != fLastChgState;
+#else
+	return false;
+#endif
+}

diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 047a453..a8a402f 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -128,16 +128,25 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	/* Restrict access to the battery blocks; keys retain their own lanes. */
 	unsigned peripheral = addr >> 8;
 	bool allowed = false;
-	if (!sp_ready || !out || sid != SP_BATT_SID || addr > 0xffffu) {
+	if (!sp_ready || !out || addr > 0xffffu) {
 		return -1;
 	}
-	for (unsigned i = 0; i < sizeof(sp_periph_ok) / sizeof(sp_periph_ok[0]);
-	    ++i) {
-		if (peripheral == sp_periph_ok[i]) {
-			allowed = true;
-			break;
+	if (sid == SP_BATT_SID) {
+		for (unsigned i = 0; i < sizeof(sp_periph_ok) / sizeof(sp_periph_ok[0]);
+		    ++i) {
+			if (peripheral == sp_periph_ok[i]) {
+				allowed = true;
+				break;
+			}
 		}
 	}
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+	/* 0104: read-only PON reset-reason classifier (PM8150 sid 0,
+	 * peripheral 0x8) for the USB probe. Keys retain their own lanes. */
+	if (sid == 0 && peripheral == 0x08) {
+		allowed = true;
+	}
+#endif
 	if (!allowed) {
 		return -1;
 	}
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index e561cb8..2ebf60b 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -66,6 +66,7 @@ static const struct {
 	{ "cfg-noc-axi", 0x0f078 },
 	{ "aggre-axi", 0x0f07c },
 	{ "phy-ref", 0x8c028 },
+	{ "ahb2phy", 0x6a004 },

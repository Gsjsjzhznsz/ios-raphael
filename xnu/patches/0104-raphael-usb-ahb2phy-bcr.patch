+		/* 0104: GCC_QUSB2PHY_PRIM_BCR. raphael's own kernel places it
+		 * at 0x26000 (raphael-p-oss gcc-sdmmagpie.c reset table; every
+		 * other USB/PCIe/UFS reset matches mainline, only this one
+		 * differs - mainline's 0x12000 does not exist in raphael's GCC
+		 * map and t17/t18 pulsed a no-op, so the PHY never reset).
+		 * Assert >= 100 us, then release - resets all PHY registers to
+		 * default state. Pulse the authoritative offset first, keep
+		 * mainline's as a secondary (proven harmless in t17/t18). */
+		*(volatile uint32_t *)(gccb + 0x26000) = 1;
+		delay(150);
+		*(volatile uint32_t *)(gccb + 0x26000) = 0;
 		*(volatile uint32_t *)(gccb + 0x12000) = 1;
 		delay(150);
 		*(volatile uint32_t *)(gccb + 0x12000) = 0;
@@ -987,8 +1064,24 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 		usb_phy_wr_mask(hsphy, 0x50, 1u << 1, 0);		/* UTMI_CTRL5: POR=0 (release) */
 		usb_phy_wr_mask(hsphy, 0x64, 1u << 3, 0);		/* CTRL2: SUSPEND_N_SEL=0 */
 		usb_phy_wr_mask(hsphy, 0x94, 1u << 1, 0);		/* CFG0: CMN override off */
+		/* 0104: PMIC5 rails and the PHY POR need time to settle before

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 421c92e..0d74963 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -887,6 +887,21 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	ud.dma_pa = ptoa_64(pn);
 	ud_if_create();
 
+	/* Qualcomm wrapper first (Linux dwc3-qcom forces the VBUS session at
+	 * probe time): the QSCRATCH registers live outside the DWC3 core and
+	 * survive the device soft reset below. */
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+	if (qs != 0) {
+		uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
+		printf("SWEET USB: QSCRATCH HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x GENERAL_CFG 0x%08x\n",
+		    hs, ss, usb_rd(qs, 0x08));
+		*(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL) = hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+		*(volatile uint32_t *)(qs + QSCRATCH_SS_PHY_CTRL) = ss | LANE0_PWR_PRESENT;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("SWEET USB: VBUS override on: HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x\n",
+		    usb_rd(qs, QSCRATCH_HS_PHY_CTRL), usb_rd(qs, QSCRATCH_SS_PHY_CTRL));
+	}
+
 	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
 	dwc_wr(DCTL, DCTL_CSFTRST);
 	int i;
@@ -898,12 +913,21 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
 		return;
 	}
+	/* DWC_usb31 (raphael, GSNPSID 0x3331xxxx): after DCTL.CSFTRST clears,
+	 * the device/endpoint clock domains must re-synchronize before any
+	 * endpoint command or the access can wedge the bus. Linux
+	 * dwc3_core_soft_reset() waits 50 ms for DWC31 <= 1.80a; t14 wedged
+	 * right here with no timeout print. sweet's classic DWC3 3.20a needs
+	 * no settle at all, which is why the same code worked upstream. */
+	delay(100000);	/* 100 ms */
+	printf("SWEET USB: DWC31 post-reset settle done\n");
 
 	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
 	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
 	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
 	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
 	ud.evt_pos = 0;
+	printf("SWEET USB: event buffer armed at 0x%llx\n", ud.dma_pa + UD_EVT);
 
 	/* High speed, address 0 */
 	uint32_t dcfg = dwc_rd(DCFG) & ~(7u | (0x7fu << 3));
@@ -912,6 +936,7 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	dwc_wr(DEVTEN, 0x7);
 
 	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
+	printf("SWEET USB: ep0 DEPSTARTCFG/SETEPCONFIG/SETTRANSFRESOURCE\n");
 	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
 	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
 	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
@@ -922,18 +947,7 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	}
 	dwc_wr(DALEPENA, 0x3);
 	ud_start_setup();
-
-	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
-	if (qs != 0) {
-		uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
-		printf("SWEET USB: QSCRATCH HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x GENERAL_CFG 0x%08x\n",
-		    hs, ss, usb_rd(qs, 0x08));
-		*(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL) = hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
-		*(volatile uint32_t *)(qs + QSCRATCH_SS_PHY_CTRL) = ss | LANE0_PWR_PRESENT;
-		__asm__ volatile ("dsb sy" ::: "memory");
-		printf("SWEET USB: VBUS override on: HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x\n",
-		    usb_rd(qs, QSCRATCH_HS_PHY_CTRL), usb_rd(qs, QSCRATCH_SS_PHY_CTRL));
-	}
+	printf("SWEET USB: ep0 setup TRB armed\n");
 
 	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
 	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {

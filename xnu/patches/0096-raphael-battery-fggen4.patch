+/* Shadow-verified reads, per vendor fg-util.c: fg-gen4 exposes each live
+ * datum next to an atomically latched copy (_CP); equal values certify a
+ * non-torn sample without any HOLD side effects. */
+static bool
+fgReadShadowByte(unsigned address, unsigned copyAddress, uint8_t *value)
+{
+        for (unsigned attempt = 0; attempt < 4; ++attempt) {
+                uint8_t a, b;
+                if (sweet_spmi_read(SWEETBATT_SID, address, &a) ||
+                    sweet_spmi_read(SWEETBATT_SID, copyAddress, &b)) {
+                        return false;
+                }
+                if (a == b) {
+                        *value = a;
+                        return true;
+                }
+        }
+        return false;
+}
+
+static bool
+fgReadShadowWord(unsigned address, unsigned copyAddress, uint16_t *value)
+{
+        for (unsigned attempt = 0; attempt < 4; ++attempt) {
+                uint8_t a0, a1, b0, b1;
+                if (sweet_spmi_read(SWEETBATT_SID, address, &a0) ||
+                    sweet_spmi_read(SWEETBATT_SID, address + 1, &a1) ||
+                    sweet_spmi_read(SWEETBATT_SID, copyAddress, &b0) ||
+                    sweet_spmi_read(SWEETBATT_SID, copyAddress + 1, &b1)) {
+                        return false;
+                }
+                if (a0 == b0 && a1 == b1) {
+                        *value = (uint16_t)((unsigned)a0 | ((unsigned)a1 << 8));
+                        return true;
+                }
+        }
+        return false;
+}

+ * mapping: 255 -> 100, 0 -> 0, otherwise round((raw-1)*98/253) + 1 so the
+ * endpoints stay clean and the 1..254 span maps onto 1..99. */
+static unsigned
+fgMonotonicPercent(uint8_t raw)
+{
+        if (raw == 0xffu) {
+                return 100;
+        }
+        if (raw == 0u) {
+                return 0;
+        }
+        return (unsigned)((((unsigned)raw - 1u) * 98u + 126u) / 253u) + 1u;

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index ec4b806..1a9870b 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -94,6 +94,16 @@ usb_rd(vm_offset_t base, uint32_t off)
 	return v;
 }
 
+static void
+usb_phy_wr_mask(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t val)
+{
+	uint32_t reg = usb_rd(base, off);
+	reg &= ~mask;
+	reg |= val & mask;
+	*(volatile uint32_t *)(base + off) = reg;
+	(void)usb_rd(base, off);	/* readback: ensure the write reached the PHY */
+}
+
 void
 sweet_usb_probe(void)
 {
@@ -148,11 +158,13 @@ sweet_usb_probe(void)
 	if (phy == 0) {
 		return;
 	}
-	/* DT qcom,qusb-phy-reg-offset order (Linux phy-msm-qusb-v2.c): PORT_TUNE1 0x240,
-	 * PLL_COMMON_STATUS_ONE 0x1a0, PWR_CTRL1 0x210, INTR_CTRL 0x230,
-	 * PLL_CORE_INPUT_OVERRIDE 0x0a8, TEST1 0x254. */
-	printf("SWEET USB: QUSB2 PLL_STATUS 0x%08x PWR_CTRL1 0x%08x PORT_TUNE1 0x%08x TEST1 0x%08x\n",
-	    usb_rd(phy, 0x1a0), usb_rd(phy, 0x210), usb_rd(phy, 0x240), usb_rd(phy, 0x254));
+	/* sm8150 HS PHY = 7nm Synopsys femto (Linux phy-qcom-snps-femto-v2.c,
+	 * compatible qcom,sm8150-usb-hs-phy): registers live at 0x3c-0xa0; the
+	 * old qusb2-v2 map (TUNE1 0x240, PWR_CTRL1 0x210, PLL_STATUS 0x1a0)
+	 * does not exist on this PHY generation. */
+	printf("SWEET USB: hsphy COMMON0 0x%08x COMMON1 0x%08x COMMON2 0x%08x CTRL1 0x%08x CTRL2 0x%08x REFCLK 0x%08x\n",
+	    usb_rd(phy, 0x54), usb_rd(phy, 0x58), usb_rd(phy, 0x5c), usb_rd(phy, 0x60),
+	    usb_rd(phy, 0x64), usb_rd(phy, 0xa0));
 }
 
 /*
@@ -909,6 +921,52 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	    phycfg, dwc_rd(GUSB2PHYCFG));
 #endif
 
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+	/* 0102: power up the 7nm Synopsys HS PHY - register-for-register port
+	 * of Linux phy-qcom-snps-femto-v2.c qcom_snps_hsphy_init() for
+	 * "qcom,sm8150-usb-hs-phy". t16 evidence: after the ABL handoff the
+	 * USB block is reset (QSCRATCH HS/SS_PHY_CTRL 0x0) and the PHY is
+	 * powered down; DEPCMD READS still complete (the canary printed) but
+	 * the first command WRITE stalls the AXI bus - the endpoint command
+	 * state machine is clocked from the PHY's UTMI clock. Warm boots wedge
+	 * the same way with the PHY suspended (t15 SUSPHY=1), so ABL leftovers
+	 * never work: the PHY must be brought up from scratch, exactly like
+	 * Linux does at every probe. Order matches dwc3_core_init: phy_setup
+	 * (SUSPHY clear above) -> phy_init (here) -> device soft reset (below). */
+	vm_offset_t hsphy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+	vm_offset_t gccb = ml_io_map(GCC_PA, GCC_SIZE);
+	if (hsphy != 0 && gccb != 0) {
+		printf("SWEET USB: hsphy pre-state COMMON0 0x%08x CTRL2 0x%08x CTRL5 0x%08x CFG0 0x%08x\n",
+		    usb_rd(hsphy, 0x54), usb_rd(hsphy, 0x64), usb_rd(hsphy, 0x50), usb_rd(hsphy, 0x94));
+		/* GCC_QUSB2PHY_PRIM_BCR 0x12000 (gcc-sm8150.c): assert >= 100 us,
+		 * then release - resets all PHY registers to default state. */
+		*(volatile uint32_t *)(gccb + 0x12000) = 1;
+		delay(150);
+		*(volatile uint32_t *)(gccb + 0x12000) = 0;
+		usb_phy_wr_mask(hsphy, 0x94, 1u << 1, 1u << 1);	/* CFG0: CMN_CTRL_OVERRIDE_EN */
+		usb_phy_wr_mask(hsphy, 0x50, 1u << 1, 1u << 1);	/* UTMI_CTRL5: POR=1 */
+		usb_phy_wr_mask(hsphy, 0x54, 0x70, 0);			/* COMMON0: FSEL=000 */
+		usb_phy_wr_mask(hsphy, 0x58, 1u << 5, 1u << 5);	/* COMMON1: PLLBTUNE */
+		usb_phy_wr_mask(hsphy, 0xa0, 0x3, 0x2);		/* REFCLK_CTRL: REFCLK_SEL=10b */
+		usb_phy_wr_mask(hsphy, 0x58, 1u << 4, 1u << 4);	/* COMMON1: VBUSVLDEXTSEL0 */
+		usb_phy_wr_mask(hsphy, 0x60, 1u << 0, 1u << 0);	/* CTRL1: VBUSVLDEXT0 */
+		/* raphael board tunes (vendor raphael dtsi qcom,param-override-seq):
+		 * OVERRIDE_X1 0x83 = hs-amplitude 3 + preemphasis-amplitude 2,
+		 * OVERRIDE_X2 0x2c = crossover 3 + output-impedance 2. */
+		usb_phy_wr_mask(hsphy, 0x70, 0xff, 0x83);
+		usb_phy_wr_mask(hsphy, 0x74, 0xff, 0x2c);
+		usb_phy_wr_mask(hsphy, 0x5c, 1u << 0, 1u << 0);	/* COMMON2: VREGBYPASS */
+		usb_phy_wr_mask(hsphy, 0x64, (1u << 3) | (1u << 2), (1u << 3) | (1u << 2));	/* CTRL2: SUSPEND_N_SEL|SUSPEND_N */
+		usb_phy_wr_mask(hsphy, 0x3c, 1u << 0, 1u << 0);	/* UTMI_CTRL0: SLEEPM */
+		usb_phy_wr_mask(hsphy, 0x54, 1u << 2, 0);		/* COMMON0: SIDDQ=0 (power on) */
+		usb_phy_wr_mask(hsphy, 0x50, 1u << 1, 0);		/* UTMI_CTRL5: POR=0 (release) */
+		usb_phy_wr_mask(hsphy, 0x64, 1u << 3, 0);		/* CTRL2: SUSPEND_N_SEL=0 */
+		usb_phy_wr_mask(hsphy, 0x94, 1u << 1, 0);		/* CFG0: CMN override off */
+		printf("SWEET USB: hsphy up (femto): COMMON0 0x%08x COMMON1 0x%08x CTRL2 0x%08x REFCLK 0x%08x\n",
+		    usb_rd(hsphy, 0x54), usb_rd(hsphy, 0x58), usb_rd(hsphy, 0x64), usb_rd(hsphy, 0xa0));
+	}
+#endif
+
 	/* Qualcomm wrapper first (Linux dwc3-qcom forces the VBUS session at
 	 * probe time): the QSCRATCH registers live outside the DWC3 core and
 	 * survive the device soft reset below. */

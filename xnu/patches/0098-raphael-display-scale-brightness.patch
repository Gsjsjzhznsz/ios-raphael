+/* Raphael panel control through the DSI command DMA, exactly the vendor
+ * path (MiCode raphael-p-oss, samsung EA8076 AMOLED, dsi_lp_mode):
+ * brightness is DCS 0x51 with a big-endian 11-bit level
+ * (mipi_dsi_dcs_set_display_brightness_ss, max 2047 per
+ * qcom,mdss-brightness-max-level); display off/on is DCS 0x28/0x29.
+ * Controller: mdss_dsi_ctrl0 @ 0x0ae94000 (DSI 6G v2.2). Commands go
+ * through the TPG DMA FIFO like vendor dsi_ctrl_hw_cmn_kickoff_fifo_command
+ * in secure sessions: dwords [wc_lo wc_hi data_id flags] then payload,
+ * padded with 0xff; flags bit7 = last command, bit6 = payload present
+ * (dsi_ctrl_copy_and_pad_cmd / MIPI_DSI_MSG_LASTCOMMAND). */
+#define SWEET_FB_DSI_PA               0x0ae94000ull
+#define SWEET_FB_DSI_LEN              0x400ull
+#define SWEET_FB_DSI_CTRL             0x000u
+#define SWEET_FB_DSI_CMD_DMA_CTRL     0x03cu
+#define SWEET_FB_DSI_DMA_CMD_LENGTH   0x04cu
+#define SWEET_FB_DSI_SW_TRIGGER       0x090u
+#define SWEET_FB_DSI_INT_CTRL         0x110u
+#define SWEET_FB_DSI_TPG_CTRL         0x15cu
+#define SWEET_FB_DSI_TPG_CMD_INIT_VAL 0x17cu
+#define SWEET_FB_DSI_TPG_FIFO_RESET   0x1ecu
+#define SWEET_FB_BRIGHT_MIN           4u      /* first clearly visible level */
+#define SWEET_FB_BRIGHT_MAX           2047u   /* qcom,mdss-brightness-max-level */
+
+static uint32_t
+fbDsiR(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+fbDsiW(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* One embedded-mode DCS packet through the TPG DMA FIFO. count is the
+ * number of packet dwords already padded to a dword boundary. Returns
+ * true once the controller reports CMD_MODE_DMA_DONE (INT_CTRL bit 0,
+ * write-1-to-clear); a timeout disqualifies the path (returns false). */
+static bool
+fbDsiSend(vm_offset_t dsi, const uint32_t *dw, uint32_t count)
+{
+	if ((fbDsiR(dsi, SWEET_FB_DSI_CTRL) & 1u) == 0u) {
+		return false;	/* controller off: nothing to talk to */
+	}
+	/* Reset the TPG DMA FIFO, then FIFO mode with the custom pattern. */
+	fbDsiW(dsi, SWEET_FB_DSI_TPG_CTRL, 0x0);
+	fbDsiW(dsi, SWEET_FB_DSI_TPG_FIFO_RESET, 0x1);
+	delay(1);
+	fbDsiW(dsi, SWEET_FB_DSI_TPG_FIFO_RESET, 0x0);
+	fbDsiW(dsi, SWEET_FB_DSI_TPG_CTRL, (1u << 1) | (1u << 2) | (0x3u << 16));
+	for (uint32_t i = 0; i < count; i++) {
+		fbDsiW(dsi, SWEET_FB_DSI_TPG_CMD_INIT_VAL, dw[i]);
+	}
+	if ((count & 1u) != 0u) {
+		fbDsiW(dsi, SWEET_FB_DSI_TPG_CMD_INIT_VAL, 0);
+	}
+	/* Embedded mode (bit 28) + low-power commands (bit 26); clear the
+	 * broadcast/master/WC_SEL/packet-type bits the vendor clears. */
+	uint32_t dma = fbDsiR(dsi, SWEET_FB_DSI_CMD_DMA_CTRL);
+	dma &= ~((1u << 31) | (1u << 30) | (1u << 29) | (1u << 24));
+	dma |= (1u << 28) | (1u << 26);
+	fbDsiW(dsi, SWEET_FB_DSI_CMD_DMA_CTRL, dma);
+	fbDsiW(dsi, SWEET_FB_DSI_DMA_CMD_LENGTH, count * 4u);
+	fbDsiW(dsi, SWEET_FB_DSI_SW_TRIGGER, 0x1);
+	for (uint32_t i = 0; i < 5000; i++) {
+		if (fbDsiR(dsi, SWEET_FB_DSI_INT_CTRL) & 1u) {
+			fbDsiW(dsi, SWEET_FB_DSI_INT_CTRL, 1u);
+			fbDsiW(dsi, SWEET_FB_DSI_TPG_CTRL, 0x0);
+			return true;
+		}
+		delay(10);	/* 10 us; up to 50 ms total */
+	}
+	fbDsiW(dsi, SWEET_FB_DSI_TPG_CTRL, 0x0);
+	return false;
+}

@@ -4,6 +4,11 @@
  * No interrupt clear, peripheral enable, charger config, or PMIC writes.
  * Init is serialized by the single built-in SweetBattery personality.
  * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
+ * Board layout: SWEET reads the PM6150 (SID 0, QG at 0x48xx);
+ * raphael reads the PM8150B battery PMIC on SPMI SID 2, whose
+ * fg-gen4 QG (fg-batt-soc@4000) exposes the same live V/I mirrors
+ * at 0x40xx. The SMB5 charger blocks 0x10-0x13 are the same IP on
+ * both PMICs at the same offsets.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -19,6 +24,17 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 #define SP_CFG_PA  0x0c40a000u
 #define SP_NO_APID 0xffffu
 
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+/* Raphael: PM8150B battery PMIC = SPMI SID 2 (charger 0x10-0x13,
+ * QG at peripheral 0x40). Must match SWEETBATT_SID in SweetBattery.cpp. */
+#define SP_BATT_SID 2
+static const uint16_t sp_periph_ok[] = { 0x10, 0x11, 0x12, 0x13, 0x40 };
+#else
+/* SWEET: PM6150 battery PMIC = SID 0, QG at peripheral 0x48. */
+#define SP_BATT_SID 0
+static const uint16_t sp_periph_ok[] = { 0x10, 0x11, 0x12, 0x13, 0x48 };
+#endif
+
 static vm_offset_t sp_core, sp_obs, sp_cfg;
 static IOLock *sp_lock;
 static unsigned sp_count;
@@ -88,9 +104,18 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 {
 	/* Restrict access to the battery blocks; keys retain their own lanes. */
 	unsigned peripheral = addr >> 8;
-	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
-	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
-	    peripheral != 0x13 && peripheral != 0x48)) {
+	bool allowed = false;
+	if (!sp_ready || !out || sid != SP_BATT_SID || addr > 0xffffu) {
+		return -1;
+	}
+	for (unsigned i = 0; i < sizeof(sp_periph_ok) / sizeof(sp_periph_ok[0]);
+	    ++i) {
+		if (peripheral == sp_periph_ok[i]) {
+			allowed = true;
+			break;
+		}
+	}
+	if (!allowed) {
 		return -1;
 	}
 	IOLockLock(sp_lock);

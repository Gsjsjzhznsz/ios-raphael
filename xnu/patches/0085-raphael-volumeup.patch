-	 * Volume-up is not a PM6150L GPIO2 here; the TLMM/PMIC mapping is
-	 * not yet confirmed from the live DT, so keep it withheld. */
-	keys_gpio_apid = KEYS_NO_APID;
-	printf("SWEET KEYS: raphael volume-up withheld (mapping TBD from live DT)\n");
+	/* K20 Pro: power = PM8150 PON KPDPWR, volume-down = PON RESIN,
+	 * volume-up = PM8150 GPIO6 (mainline dts: pm8150_gpios 6, active-low). */
+	keys_gpio_apid = keys_find_apid(KEYS_GPIO_PPID, count);
+	keys_gpio_census(count);
 #else
-	keys_gpio_apid = keys_find_apid(0x4c1, count);
+	keys_gpio_apid = keys_find_apid(KEYS_GPIO_PPID, count);
 #endif
 	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
 	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
-	bool mok = keys_read(keys_gpio_apid, 0xc140, &mode);
-	bool eok = keys_read(keys_gpio_apid, 0xc146, &en);
-	bool sok = keys_read(keys_gpio_apid, 0xc105, &subtype);
+	bool mok = keys_read(keys_gpio_apid, KEYS_GPIO_MODE, &mode);
+	bool eok = keys_read(keys_gpio_apid, KEYS_GPIO_EN, &en);
+	bool sok = keys_read(keys_gpio_apid, KEYS_GPIO_TYPE, &subtype);
 	printf("SWEET KEYS: arb=%#x apids=%u pon-apid=%u gpio4-apid=%u pon=%#x/%d gpio=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d\n",
 	    keys_version, count, keys_pon_apid, keys_gpio_apid,
 	    pon, pok, gpio, gok, mode, mok, en, eok, subtype, sok);

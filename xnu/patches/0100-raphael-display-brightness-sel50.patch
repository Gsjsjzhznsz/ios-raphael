+/* CoreBrightness/backboardd drives panel brightness through IOMFB sel 50
+ * (setBrightnessCorrection) in 0..10000 units; the t21 log caught
+ * backboardd calling it with 10000. Map that onto the panel's 11-bit
+ * DCS 0x51 level (4..2047) with a perceptual table so the low end of the
+ * slider is usable; linear between points. */
+static uint32_t
+sweetFbPanelLevel(uint32_t v)
+{
+	static const uint32_t vv[] = { 0, 1000, 2000, 3000, 4000, 5000,
+	    6000, 7000, 8000, 9000, 10000 };
+	static const uint32_t ll[] = { 4, 14, 40, 92, 180, 320,
+	    530, 830, 1220, 1620, 2047 };
+	if (v >= 10000u) {
+		return 2047u;
+	}
+	for (unsigned i = 1; i < sizeof(vv) / sizeof(vv[0]); i++) {
+		if (v <= vv[i]) {
+			uint32_t span = vv[i] - vv[i - 1];
+			uint32_t off = v - vv[i - 1];
+			return ll[i - 1] +
+			    (uint32_t)(((uint64_t)(ll[i] - ll[i - 1]) * off) / span);
+		}
+	}
+	return SWEET_FB_BRIGHT_MIN;
+}
